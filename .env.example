WS_HOST=127.0.0.1
SAVE_DIR=/tmp
WHISPER_HOST=whisper
WHISPER_PORT=8080
WHISPER_VERSION=1.8.4
WHISPER_LANGUAGE=pt
LOG_LEVEL=INFO
DEBUG_GRAVAI=False
# Only used when a Google Meet turns an anonymous guest away. Leave empty to
# always join as a guest. The account has to sign in with a password alone -
# 2-Step Verification cannot be answered from the container.
GOOGLE_ACCOUNT_EMAIL=
GOOGLE_ACCOUNT_PASSWORD=
# A CAPTCHA on the Google sign-in is the one refusal a person can clear, so the
# recorder's screen goes on a VNC port and waits for one. Leave VNC_PASSWORD
# empty and a throwaway password is generated per challenge and logged with the
# port. Set VNC_ENABLED=False to record headless, where a CAPTCHA ends the join.
VNC_ENABLED=True
VNC_HOST=0.0.0.0
VNC_PORT=5900
VNC_PASSWORD=
VNC_CAPTCHA_TIMEOUT_S=600

GRAVAI_TEST_TEAMS_MEETING_URL=
GRAVAI_TEST_MEET_MEETING_URL=