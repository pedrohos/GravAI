# Where recordings are written. /tmp is the default and is cleared by the system;
# the catalogue below outlives it, so a meeting can read back with its transcript
# and no audio left behind it. Point this at a volume to keep the audio.
SAVE_DIR=/tmp
# SQLite file holding the job queue and the catalogue of recordings. Put it on a
# volume so a restart remembers the meetings that were recorded.
DATABASE_PATH=./data/gravai.db
WHISPER_HOST=whisper
WHISPER_PORT=8080
WHISPER_VERSION=1.8.4
WHISPER_LANGUAGE=pt
# Origins a browser may call this API from, comma separated. Empty is right for
# the shipped setup: the frontend container calls this API from its own Next.js
# server over the Docker network, so no browser ever calls it cross-origin. Only
# fill this in if you put a browser on this API directly. This API has no
# authentication, so an origin listed here is trusted to start recordings and
# read every transcript: name the exact origins, and never use '*'.
CORS_ALLOW_ORIGINS=
LOG_LEVEL=INFO
# How many lines of a session log GET /jobs/{id}/log returns by default.
JOB_LOG_TAIL_LINES=400
DEBUG_GRAVAI=False
# Only used when a Google Meet turns an anonymous guest away. Leave empty to
# always join as a guest. The account has to sign in with a password alone -
# 2-Step Verification cannot be answered from the container.
GOOGLE_ACCOUNT_EMAIL=
GOOGLE_ACCOUNT_PASSWORD=
# A CAPTCHA on the Google sign-in is the one refusal a person can clear, so the
# recorder's screen goes on a VNC port and waits for one. Leave VNC_PASSWORD
# empty and a throwaway password is generated per challenge and logged with the
# port. Set VNC_ENABLED=False to record headless, where a CAPTCHA ends the join.
VNC_ENABLED=True
VNC_HOST=0.0.0.0
VNC_PORT=5900
VNC_PASSWORD=
VNC_CAPTCHA_TIMEOUT_S=600

GRAVAI_TEST_TEAMS_MEETING_URL=
GRAVAI_TEST_MEET_MEETING_URL=